# ── Metabase ───────────────────────────────────────────────────────────────────
METABASE_URL=https://metabase.yourcompany.com

# Auth — use ONE of the three options below:

# Option A: API key (Metabase >= v0.47)
# METABASE_API_KEY=mb_xxxxxxxxxxxxxxxxxxxx

# Option B: Browser session token  ← USE THIS for Google SSO
#   1. Open Metabase in Chrome, sign in via Google
#   2. F12 → Application → Cookies → find metabase.SESSION → copy Value
#   Note: re-copy when it expires (~2 weeks or on logout)
METABASE_SESSION=your-session-token-here

# Option C: Username + password (traditional login only)
# METABASE_USER=your@email.com
# METABASE_PASS=yourpassword

# Database ID — leave blank on first run, script will list available DBs
METABASE_DB_ID=

# Saved question ID (recommended)
# URL: metabase.company.com/question/112 → set 112 here
METABASE_QUESTION_ID=

# ── Anthropic (optional) ───────────────────────────────────────────────────────
# ANTHROPIC_API_KEY=sk-ant-...
