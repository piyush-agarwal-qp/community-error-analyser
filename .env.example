# ── Metabase ───────────────────────────────────────────────────────────────────
METABASE_URL=https://metabase.questionpro.net

# Auth — use ONE of the three options below:

# Option A: API key (Metabase >= v0.47)
# METABASE_API_KEY=mb_xxxxxxxxxxxxxxxxxxxx

# Option B: Browser session token  ← USE THIS for Google SSO
#   1. Open https://metabase.questionpro.net in Chrome, sign in via Google
#   2. F12 → Application → Cookies → find metabase.SESSION → copy Value
#   Note: re-copy when it expires (~2 weeks or on logout)
METABASE_SESSION=your-session-token-here

# Option C: Username + password (traditional login only)
# METABASE_USER=your@email.com
# METABASE_PASS=yourpassword

# ── Question ID ────────────────────────────────────────────────────────────────
# Saved Metabase question used to pull weekly Communities errors.
# Reference question (open to understand the query and get the ID):
#   https://metabase.questionpro.net/question/7148-weekly-error-report-communities?date_from=2026-05-29&date_to=2026-06-04
#
# The ID is the number after /question/ in the URL → 7148
METABASE_QUESTION_ID=7148

# ── Database ID ────────────────────────────────────────────────────────────────
# Only needed if running raw SQL mode (no saved question).
# Leave blank — the script will list available DBs on first run.
METABASE_DB_ID=

# ── Anthropic (optional) ───────────────────────────────────────────────────────
# ANTHROPIC_API_KEY=sk-ant-...
