# ── Metabase ───────────────────────────────────────────────────────────────────
METABASE_URL=https://metabase.questionpro.net

# Session token from browser — for Google SSO users (recommended)
#   1. Open metabase.questionpro.net in Chrome, sign in via Google
#   2. F12 → Application → Cookies → find metabase.SESSION → copy Value
#   Note: re-copy when it expires (~2 weeks or on logout)
METABASE_SESSION_TOKEN=paste-your-metabase.SESSION-cookie-value-here

# ── Error report (500 errors) ──────────────────────────────────────────────────
# US question: https://metabase.questionpro.net/question/7162
# EU question: https://metabase.questionpro.net/question/7163
METABASE_QUESTION_ID_US=7162
METABASE_QUESTION_ID_EU=7163

# ── Radar tickets ─────────────────────────────────────────────────────────────
METABASE_QUESTION_ID_RADAR=7302

# ── Performance metrics ────────────────────────────────────────────────────────
METABASE_QUESTION_ID_PERF_ADMIN=7301
METABASE_QUESTION_ID_PERF_PORTAL=7300
